POSTGRES_DB=mcp_rag_notebook
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace_me

DATABASE_URL=postgresql+asyncpg://rag_user:replace_me@localhost:5432/mcp_rag_notebook

REDIS_URL=redis://localhost:6379/0

MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowledge_chunks

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_me
MINIO_ENDPOINT=localhost:19000
MINIO_BUCKET=rag-files
MINIO_SECURE=false

EMBEDDING_MODEL=BAAI/bge-m3
# Default: a Docker-managed volume shared by backend and worker.
HF_CACHE_DIR=hf_cache
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_OFFLINE=false
MCP_DYNAMIC_REGISTRY_ENABLED=false
# Optional GraphRAG indexing; can also be triggered from the graph page.
GRAPH_AUTO_EXTRACT_ENABLED=false

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=3
DEEPSEEK_MAX_RETRIES=4
DEEPSEEK_RETRY_BACKOFF_SECONDS=0.5
DEEPSEEK_TRUST_ENV=false

RAG_DEFAULT_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_MIN_RELEVANCE_SCORE=0.5
INGESTION_STALE_AFTER_SECONDS=1800

RAG_BACKEND_URL=http://127.0.0.1:8765

MCP_AGENT_ALLOWED_TOOLS=rag_notebook:create_note,rag_notebook:search_notes,rag_notebook:summarize_document,filesystem:list_allowed_directories,filesystem:list_directory,filesystem:read_text_file,filesystem:search_files,fetch:fetch
MCP_AGENT_MAX_STEPS=4
MCP_TOOL_RESULT_MAX_CHARS=12000

MCP_CLIENT_ALLOWED_TOOLS=rag_notebook:backend_health,rag_notebook:search_knowledge_base,filesystem:list_allowed_directories,filesystem:list_directory,filesystem:read_text_file,filesystem:search_files,filesystem:get_file_info,fetch:fetch
MCP_TOOL_TIMEOUT_SECONDS=180
MCP_TOOL_RETRY_ATTEMPTS=2
MCP_TOOL_RETRY_BACKOFF_SECONDS=1

JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Local HTTP development: false. Production behind HTTPS: true.
AUTH_COOKIE_SECURE=false
# Comma-separated frontend origins; do not use '*' with credentialed cookies.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Docker Desktop on this Windows host exposes the API on 18765 (container port 8765).
VITE_API_BASE_URL=http://127.0.0.1:18765

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

RAG_QUERY_REWRITE_ENABLED=false
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=8
RAG_ROUTE_SCORE_MARGIN=0.03

RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=8
RERANKER_ENABLED=false
RERANKER_TIMEOUT_SECONDS=5

ASR_PRIMARY_MODEL=base
ASR_FALLBACK_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

ASR_QUALITY_LOGPROB_THRESHOLD=-1.0
ASR_QUALITY_NO_SPEECH_THRESHOLD=0.6

MULTIMODAL_GLOSSARY=Milvus,BGE-M3,MinIO,PostgreSQL,Redis,Celery,FastAPI,Whisper,RapidOCR

OCR_MIN_SCORE=0.5
VIDEO_KEYFRAME_INTERVAL_SECONDS=2.0
FFMPEG_BINARY=ffmpeg
ASR_SAMPLE_RATE=16000
VIDEO_SCENE_DETECTION_ENABLED=true
VIDEO_SCENE_THRESHOLD=0.18
VIDEO_TIMELINE_WINDOW_SECONDS=8.0
VIDEO_TIMELINE_MERGE_GAP_SECONDS=1.5

MULTIMODAL_ALIASES_JSON={}

RAG_BACKEND_URL=http://127.0.0.1:8765
RAG_ACCESS_TOKEN=
MCP_AUDIT_TOKEN=
